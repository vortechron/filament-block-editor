{
    "name": "vortechron/filament-block-editor",
    "description": "A page builder for Laravel and Filament 5: BlockNote content in styled sections, rendered to plain HTML and CSS, with your own blocks and section templates.",
    "keywords": [
        "filament",
        "filament-plugin",
        "laravel",
        "blocknote",
        "page-builder",
        "block-editor"
    ],
    "homepage": "https://github.com/vortechron/filament-block-editor",
    "license": "GPL-3.0-or-later",
    "type": "library",
    "authors": [
        {
            "name": "Vortechron",
            "homepage": "https://vortechron.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.7",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Vortechron\\FilamentBlockEditor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vortechron\\FilamentBlockEditor\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "test": "@php vendor/bin/phpunit",
        "format": "@php vendor/bin/pint",
        "lint": [
            "@php vendor/bin/pint --ansi"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vortechron\\FilamentBlockEditor\\FilamentBlockEditorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
